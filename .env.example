# Required hosts (bare host, no scheme). Copy to .env and set.
NEXT_PUBLIC_MAIN_HOST=
NEXT_PUBLIC_API_HOST=
NEXT_PUBLIC_ID_HOST=
NEXT_PUBLIC_ADMIN_HOST=
NEXT_PUBLIC_EXERCISES_HOST=
NEXT_PUBLIC_EVENT_DOMAIN=
# Domain attribute of the shared theme/consent cookies (e.g. cybericebox.com); no implicit parent.
NEXT_PUBLIC_COOKIE_DOMAIN=
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Optional
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# Bot check provider: turnstile | recaptcha | none (none = local development). A provider needs the site key.
NEXT_PUBLIC_CAPTCHA_PROVIDER=none
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
# Only for recaptcha: true = Enterprise, false = v3.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE=false
# Client token (anti-DoS): on | off. Must match the backend DOS_PROTECTION.
NEXT_PUBLIC_DOS_PROTECTION=off
DEV_ALLOWED_ORIGINS=
