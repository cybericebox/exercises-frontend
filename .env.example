# Copy to .env (.env.local) for local dev. Every value is required except the optional ones and the host overrides; no defaults in code.
# NEXT_PUBLIC_DOMAIN is a bare lower case host name (no scheme, port or path). Every host below that is not set is derived from it; a host that
# is set wins. Without NEXT_PUBLIC_DOMAIN every host must be set.
NEXT_PUBLIC_DOMAIN=cybericebox.example
#NEXT_PUBLIC_MAIN_HOST=            # default: <DOMAIN>
#NEXT_PUBLIC_API_HOST=             # default: api.<DOMAIN>
#NEXT_PUBLIC_ID_HOST=              # default: id.<DOMAIN>
#NEXT_PUBLIC_ADMIN_HOST=           # default: admin.<DOMAIN>
#NEXT_PUBLIC_EXERCISES_HOST=       # default: exercises.<DOMAIN>
#NEXT_PUBLIC_EVENT_DOMAIN=         # event sites are <tag>.<EVENT_DOMAIN>; default: <DOMAIN>
#NEXT_PUBLIC_COOKIE_DOMAIN=        # Domain attribute of the shared theme/consent cookies; default: <DOMAIN>
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Optional
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
DEV_ALLOWED_ORIGINS=
# Container listeners (nginx image only, runtime env, see README "Listeners and TLS"). All optional.
# HTTP_PORT=3000
# HTTPS_PORT=8443
# TLS_CERT_FILE=/tls/tls.crt
# TLS_KEY_FILE=/tls/tls.key
# TLS_MIN_VERSION=1.2
# TLS_CLIENT_CA_FILE=/ca/ca.crt
# TLS_CLIENT_AUTH=off
# HEALTH_PORT=
# TLS_RELOAD_INTERVAL=60
