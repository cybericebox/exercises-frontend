# Required hosts (bare host, no scheme). Copy to .env and set.
NEXT_PUBLIC_MAIN_HOST=
NEXT_PUBLIC_API_HOST=
NEXT_PUBLIC_ID_HOST=
NEXT_PUBLIC_ADMIN_HOST=
NEXT_PUBLIC_EXERCISES_HOST=
NEXT_PUBLIC_EVENT_DOMAIN=
# Domain attribute of the shared theme/consent cookies (e.g. cybericebox.com); no implicit parent.
NEXT_PUBLIC_COOKIE_DOMAIN=
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Optional
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
DEV_ALLOWED_ORIGINS=
# Container listeners (nginx image only, runtime env, see README "Listeners and TLS"). All optional.
# HTTP_PORT=3000
# HTTPS_PORT=8443
# TLS_CERT_FILE=/tls/tls.crt
# TLS_KEY_FILE=/tls/tls.key
# TLS_MIN_VERSION=1.2
# TLS_CLIENT_CA_FILE=/ca/ca.crt
# TLS_CLIENT_AUTH=off
# HEALTH_PORT=
# TLS_RELOAD_INTERVAL=60
